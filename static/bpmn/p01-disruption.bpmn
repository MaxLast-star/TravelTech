<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_p01-disruption" targetNamespace="http://travel-irops" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:message id="Message_disruption_detected" name="disruption.detected.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=bookingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_disruption_notified" name="disruption.notified.v1" />
  <bpmn:message id="Message_disruption_resolved" name="disruption.resolved.v1" />
  <bpmn:message id="Message_decision_requested" name="decision.requested.v1" />
  <bpmn:message id="Message_decision_reminded" name="decision.reminded.v1" />
  <bpmn:message id="Message_decision_submitted" name="decision.submitted.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=disruptionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_rebooking_failed" name="Перебронирование не выполнено" errorCode="REBOOKING_FAILED" />
  <bpmn:collaboration id="Collaboration_p01">
    <bpmn:participant id="Participant_detection" name="Сервис детекции сбоя" />
    <bpmn:participant id="Participant_system" name="TravelTech IROPS. Обработка сбоя рейса" processRef="p01-disruption" />
    <bpmn:participant id="Participant_traveller" name="Путешественник" />
    <bpmn:messageFlow id="MF1" name="disruption.detected.v1" sourceRef="Participant_detection" targetRef="P-01.S1" />
    <bpmn:messageFlow id="MF4" name="disruption.notified.v1" sourceRef="P-01.E1" targetRef="Participant_traveller" />
    <bpmn:messageFlow id="MF7" name="decision.requested.v1" sourceRef="P-01.M2" targetRef="Participant_traveller" />
    <bpmn:messageFlow id="MF8" name="decision.reminded.v1" sourceRef="P-01.E4" targetRef="Participant_traveller" />
    <bpmn:messageFlow id="MF10" name="decision.submitted.v1" sourceRef="Participant_traveller" targetRef="P-01.T3" />
    <bpmn:messageFlow id="MF11" name="disruption.resolved.v1" sourceRef="P-01.M3" targetRef="Participant_traveller" />
  </bpmn:collaboration>
  <bpmn:process id="p01-disruption" name="P-01 Обработка сбоя рейса" isExecutable="true">
    <bpmn:startEvent id="P-01.S1" name="Сбой детектирован">
      <bpmn:outgoing>P-01.F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_1" messageRef="Message_disruption_detected" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P-01.T1" name="Оценить влияние на план поездки">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="impact-assessment" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F1</bpmn:incoming>
      <bpmn:outgoing>P-01.F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-01.G1" name="План исполним?" default="P-01.F4">
      <bpmn:incoming>P-01.F2</bpmn:incoming>
      <bpmn:outgoing>P-01.F3</bpmn:outgoing>
      <bpmn:outgoing>P-01.F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-01.G2" name="Есть годные варианты?">
      <bpmn:incoming>P-01.F5</bpmn:incoming>
      <bpmn:outgoing>P-01.F6</bpmn:outgoing>
      <bpmn:outgoing>P-01.F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P-01.F1" sourceRef="P-01.S1" targetRef="P-01.T1" />
    <bpmn:sequenceFlow id="P-01.F2" sourceRef="P-01.T1" targetRef="P-01.G1" />
    <bpmn:sequenceFlow id="P-01.F3" name="План исполним" sourceRef="P-01.G1" targetRef="P-01.E1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=impactClass = "исполним"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-01.F4" name="План под угрозой" sourceRef="P-01.G1" targetRef="P-01.T2" />
    <bpmn:sequenceFlow id="P-01.F5" sourceRef="P-01.T2" targetRef="P-01.G2" />
    <bpmn:sequenceFlow id="P-01.F6" name="Годных нет" sourceRef="P-01.G2" targetRef="P-01.G7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(eligibleAlternatives) = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-01.F11" sourceRef="P-01.M2" targetRef="P-01.G5" />
    <bpmn:sequenceFlow id="P-01.F12" sourceRef="P-01.G5" targetRef="P-01.T3" />
    <bpmn:sequenceFlow id="P-01.F13" name="Выбор получен" sourceRef="P-01.T3" targetRef="P-01.G6" />
    <bpmn:sequenceFlow id="P-01.F14" sourceRef="P-01.B1" targetRef="P-01.T4" />
    <bpmn:sequenceFlow id="P-01.F15" sourceRef="P-01.B2" targetRef="P-01.E4" />
    <bpmn:sequenceFlow id="P-01.F16" sourceRef="P-01.T4" targetRef="P-01.G4" />
    <bpmn:sequenceFlow id="P-01.F17" name="Применить автоматически" sourceRef="P-01.G4" targetRef="P-01.G6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=policyOutcome = "auto"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-01.F18" name="Ждать, второе окно" sourceRef="P-01.G4" targetRef="P-01.G5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=policyOutcome = "wait"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-01.F19" name="Эскалировать" sourceRef="P-01.G4" targetRef="P-01.G7" />
    <bpmn:sequenceFlow id="P-01.F20" sourceRef="P-01.G6" targetRef="P-01.T5" />
    <bpmn:sequenceFlow id="P-01.F21" sourceRef="P-01.T5" targetRef="P-01.M3" />
    <bpmn:sequenceFlow id="P-01.F22" sourceRef="P-01.M3" targetRef="P-01.E2" />
    <bpmn:sequenceFlow id="P-01.F23" sourceRef="P-01.B3" targetRef="P-01.G7" />
    <bpmn:sequenceFlow id="P-01.F24" sourceRef="P-01.G7" targetRef="P-01.T6" />
    <bpmn:sequenceFlow id="P-01.F25" sourceRef="P-01.T6" targetRef="P-01.E3" />
    <bpmn:endEvent id="P-01.E1" name="Путешественник проинформирован">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-send" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F3</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_3" messageRef="Message_disruption_notified" />
    </bpmn:endEvent>
    <bpmn:callActivity id="P-01.T2" name="Подобрать альтернативы (P-02)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="p02-alternatives" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F4</bpmn:incoming>
      <bpmn:outgoing>P-01.F5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P-01.F7" name="Есть годные" sourceRef="P-01.G2" targetRef="P-01.M2" />
    <bpmn:intermediateThrowEvent id="P-01.M2" name="Запросить решение у ответственного">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-send" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F7</bpmn:incoming>
      <bpmn:outgoing>P-01.F11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_5" messageRef="Message_decision_requested" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="P-01.G5">
      <bpmn:incoming>P-01.F11</bpmn:incoming>
      <bpmn:incoming>P-01.F18</bpmn:incoming>
      <bpmn:outgoing>P-01.F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="P-01.T3" name="Ожидать выбор альтернативы" messageRef="Message_decision_submitted">
      <bpmn:incoming>P-01.F12</bpmn:incoming>
      <bpmn:outgoing>P-01.F13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="P-01.B1" name="Ack-окно 20 минут" attachedToRef="P-01.T3">
      <bpmn:outgoing>P-01.F14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P-01.B2" name="Напоминание через 10 минут" cancelActivity="false" attachedToRef="P-01.T3">
      <bpmn:outgoing>P-01.F15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="P-01.E4" name="Напоминание отправлено">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-send" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F15</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_6" messageRef="Message_decision_reminded" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P-01.G6">
      <bpmn:incoming>P-01.F13</bpmn:incoming>
      <bpmn:incoming>P-01.F17</bpmn:incoming>
      <bpmn:outgoing>P-01.F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P-01.G4" name="Исход авто-политики" default="P-01.F19">
      <bpmn:incoming>P-01.F16</bpmn:incoming>
      <bpmn:outgoing>P-01.F17</bpmn:outgoing>
      <bpmn:outgoing>P-01.F18</bpmn:outgoing>
      <bpmn:outgoing>P-01.F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="P-01.T4" name="Применить авто-политику">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="auto-rebooking-policy" resultVariable="policyOutcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F14</bpmn:incoming>
      <bpmn:outgoing>P-01.F16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="P-01.T5" name="Перебронировать (P-03)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="p03-rebooking" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F20</bpmn:incoming>
      <bpmn:outgoing>P-01.F21</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="P-01.B3" name="Перебронирование не выполнено" attachedToRef="P-01.T5">
      <bpmn:outgoing>P-01.F23</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_1" errorRef="Error_rebooking_failed" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="P-01.G7">
      <bpmn:incoming>P-01.F6</bpmn:incoming>
      <bpmn:incoming>P-01.F19</bpmn:incoming>
      <bpmn:incoming>P-01.F23</bpmn:incoming>
      <bpmn:outgoing>P-01.F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P-01.T6" name="Разобрать сбой вручную">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="support" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F24</bpmn:incoming>
      <bpmn:outgoing>P-01.F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="P-01.M3" name="Уведомить о применённом решении">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification-send" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-01.F21</bpmn:incoming>
      <bpmn:outgoing>P-01.F22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_7" messageRef="Message_disruption_resolved" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="P-01.E2" name="Сбой закрыт">
      <bpmn:incoming>P-01.F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P-01.E3" name="Сбой закрыт оператором">
      <bpmn:incoming>P-01.F25</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_p01">
