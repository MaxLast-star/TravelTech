<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_p02-alternatives" targetNamespace="http://travel-irops" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:error id="Error_constraints_unavailable" name="Справочник ограничений недоступен" errorCode="CONSTRAINTS_UNAVAILABLE" />
  <bpmn:collaboration id="Collaboration_p02">
    <bpmn:participant id="Participant_booking" name="Провайдер бронирования" />
    <bpmn:participant id="Participant_constraints" name="Справочник ограничений" />
    <bpmn:participant id="Participant_ground" name="Поставщики наземных услуг" />
    <bpmn:participant id="Participant_system_p02" name="TravelTech IROPS. Подбор альтернатив" processRef="p02-alternatives" />
    <bpmn:messageFlow id="MF-02.1" name="Запрос альтернатив" sourceRef="P-02.T1" targetRef="Participant_booking" />
    <bpmn:messageFlow id="MF-02.2" name="Список рейсов" sourceRef="Participant_booking" targetRef="P-02.T1" />
    <bpmn:messageFlow id="MF-02.3" name="Запрос правил и норм" sourceRef="P-02.SUB1" targetRef="Participant_constraints" />
    <bpmn:messageFlow id="MF-02.4" name="MCT, визы, багажные нормы" sourceRef="Participant_constraints" targetRef="P-02.SUB1" />
    <bpmn:messageFlow id="MF-02.5" name="Запрос доступности переноса" sourceRef="P-02.T6" targetRef="Participant_ground" />
    <bpmn:messageFlow id="MF-02.6" name="Доступность и условия" sourceRef="Participant_ground" targetRef="P-02.T6" />
  </bpmn:collaboration>
  <bpmn:process id="p02-alternatives" name="P-02 Подбор альтернатив" isExecutable="true">
    <bpmn:sequenceFlow id="P-02.F7" sourceRef="P-02.B2" targetRef="P-02.E3" />
    <bpmn:sequenceFlow id="P-02.F9" sourceRef="P-02.T7" targetRef="P-02.G2" />
    <bpmn:sequenceFlow id="P-02.F8" sourceRef="P-02.T6" targetRef="P-02.T7" />
    <bpmn:sequenceFlow id="P-02.F6" sourceRef="P-02.SUB1" targetRef="P-02.T6" />
    <bpmn:sequenceFlow id="P-02.F5" sourceRef="P-02.T2" targetRef="P-02.T9" />
    <bpmn:sequenceFlow id="P-02.F17" sourceRef="P-02.T9" targetRef="P-02.SUB1" />
    <bpmn:sequenceFlow id="P-02.F4" sourceRef="P-02.G1" targetRef="P-02.T2" />
    <bpmn:sequenceFlow id="P-02.F3" name="Собрано, что успели" sourceRef="P-02.B1" targetRef="P-02.G1" />
    <bpmn:sequenceFlow id="P-02.F2" sourceRef="P-02.T1" targetRef="P-02.G1" />
    <bpmn:sequenceFlow id="P-02.F1" sourceRef="P-02.S1" targetRef="P-02.T1" />
    <bpmn:boundaryEvent id="P-02.B1" name="Окно сбора 20 с" attachedToRef="P-02.T1">
      <bpmn:outgoing>P-02.F3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_02_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P-02.B2" name="Справочник недоступен" attachedToRef="P-02.SUB1">
      <bpmn:outgoing>P-02.F7</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_02_1" errorRef="Error_constraints_unavailable" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="P-02.E3" name="Ограничения не проверены, варианты скрыты">
      <bpmn:incoming>P-02.F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P-02.T9" name="Рассчитать разницу тарифа и характер перебронирования">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fare-delta-calc" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-02.F5</bpmn:incoming>
      <bpmn:outgoing>P-02.F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="P-02.SUB1" name="Проверка жёстких ограничений">
      <bpmn:incoming>P-02.F17</bpmn:incoming>
      <bpmn:outgoing>P-02.F6</bpmn:outgoing>
      <bpmn:startEvent id="P-02.S2">
        <bpmn:outgoing>P-02.F13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="P-02.T3" name="Проверить MCT и таймзоны">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="constraint-mct-check" />
        </bpmn:extensionElements>
        <bpmn:incoming>P-02.F13</bpmn:incoming>
        <bpmn:outgoing>P-02.F14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P-02.T4" name="Проверить визы и транзитные визы">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="constraint-visa-check" />
        </bpmn:extensionElements>
        <bpmn:incoming>P-02.F14</bpmn:incoming>
        <bpmn:outgoing>P-02.F15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="P-02.T5" name="Проверить багажный тариф">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="constraint-baggage-check" />
        </bpmn:extensionElements>
        <bpmn:incoming>P-02.F15</bpmn:incoming>
        <bpmn:outgoing>P-02.F16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="P-02.E4" name="Ограничения проверены">
        <bpmn:incoming>P-02.F16</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P-02.F13" sourceRef="P-02.S2" targetRef="P-02.T3" />
      <bpmn:sequenceFlow id="P-02.F14" sourceRef="P-02.T3" targetRef="P-02.T4" />
      <bpmn:sequenceFlow id="P-02.F15" sourceRef="P-02.T4" targetRef="P-02.T5" />
      <bpmn:sequenceFlow id="P-02.F16" sourceRef="P-02.T5" targetRef="P-02.E4" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="P-02.T2" name="Собрать и дедуплицировать варианты">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="alternatives-collect" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-02.F4</bpmn:incoming>
      <bpmn:outgoing>P-02.F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-02.G1">
      <bpmn:incoming>P-02.F2</bpmn:incoming>
      <bpmn:incoming>P-02.F3</bpmn:incoming>
      <bpmn:outgoing>P-02.F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-02.T1" name="Запросить альтернативы у провайдеров">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="alternatives-search" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-02.F1</bpmn:incoming>
      <bpmn:outgoing>P-02.F2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=providers" inputElement="provider" outputCollection="rawAlternatives" outputElement="=providerResult" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:startEvent id="P-02.S1" name="Запрошен подбор альтернатив">
      <bpmn:outgoing>P-02.F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P-02.T6" name="Проверить каскад на отель и трансфер">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ground-cascade-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-02.F6</bpmn:incoming>
      <bpmn:outgoing>P-02.F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="P-02.T7" name="Ранжировать альтернативы">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="alternative-ranking" resultVariable="rankedAlternatives" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-02.F8</bpmn:incoming>
      <bpmn:outgoing>P-02.F9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="P-02.G2" name="Есть допустимые варианты?" default="P-02.F11">
      <bpmn:incoming>P-02.F9</bpmn:incoming>
      <bpmn:outgoing>P-02.F10</bpmn:outgoing>
      <bpmn:outgoing>P-02.F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-02.E1" name="Варианты подобраны">
      <bpmn:incoming>P-02.F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P-02.F10" name="Есть допустимые" sourceRef="P-02.G2" targetRef="P-02.E1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(eligibleAlternatives) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-02.F11" name="Годных нет" sourceRef="P-02.G2" targetRef="P-02.T8" />
    <bpmn:serviceTask id="P-02.T8" name="Подобрать перенос активностей и трансферов">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ground-reschedule-search" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-02.F11</bpmn:incoming>
      <bpmn:outgoing>P-02.F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P-02.E2" name="Годных рейсов нет, предложен перенос">
      <bpmn:incoming>P-02.F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P-02.F12" sourceRef="P-02.T8" targetRef="P-02.E2" />
  </bpmn:process>
