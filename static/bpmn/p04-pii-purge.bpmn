      <bpmndi:BPMNShape id="P-04.G2_di" bpmnElement="P-04.G2" isMarkerVisible="true">
        <dc:Bounds x="1312" y="465" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1297" y="524.5" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-04.E1_di" bpmnElement="P-04.E1">
