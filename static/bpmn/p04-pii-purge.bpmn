<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_p04-pii-purge" targetNamespace="http://travel-irops" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:message id="Message_trip_completed" name="trip.completed.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=tripId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_pii_mismatch" name="pii.purge.mismatch.v1" />
  <bpmn:collaboration id="Collaboration_p04">
    <bpmn:participant id="Participant_plan_p04" name="Сервис плана поездки" />
    <bpmn:participant id="Participant_obs_p04" name="Мониторинг и алерты" />
    <bpmn:participant id="Participant_system_p04" name="TravelTech IROPS. Удержание и удаление паспортных данных" processRef="p04-pii-purge" />
    <bpmn:messageFlow id="MF-04.1" name="trip.completed.v1" sourceRef="Participant_plan_p04" targetRef="P-04.S1" />
    <bpmn:messageFlow id="MF-04.2" name="pii.purge.mismatch.v1" sourceRef="P-04.M1" targetRef="Participant_obs_p04" />
  </bpmn:collaboration>
  <bpmn:process id="p04-pii-purge" name="P-04 Удаление паспортных данных" isExecutable="true">
    <bpmn:startEvent id="P-04.S1" name="Поездка завершена">
      <bpmn:outgoing>P-04.F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_04_1" messageRef="Message_trip_completed" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P-04.T1" name="Рассчитать срок удержания">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pii-retention-calc" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-04.F1</bpmn:incoming>
      <bpmn:outgoing>P-04.F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-04.G0">
      <bpmn:incoming>P-04.F2</bpmn:incoming>
      <bpmn:incoming>P-04.F7</bpmn:incoming>
      <bpmn:outgoing>P-04.F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="P-04.I1" name="Ждать срок удержания">
      <bpmn:incoming>P-04.F3</bpmn:incoming>
      <bpmn:outgoing>P-04.F4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_04_1">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">=retentionDueAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P-04.T2" name="Проверить отсутствие активных броней">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="active-booking-check" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-04.F4</bpmn:incoming>
      <bpmn:outgoing>P-04.F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-04.G1" name="Есть активные брони?" default="P-04.F8">
      <bpmn:incoming>P-04.F5</bpmn:incoming>
      <bpmn:outgoing>P-04.F6</bpmn:outgoing>
      <bpmn:outgoing>P-04.F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-04.T3" name="Перенести срок удержания">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pii-retention-postpone" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-04.F6</bpmn:incoming>
      <bpmn:outgoing>P-04.F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P-04.T4" name="Удалить паспортные данные физически">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pii-hard-delete" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-04.F8</bpmn:incoming>
      <bpmn:outgoing>P-04.F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P-04.T5" name="Записать удаление в журнал аудита">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pii-audit-append" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-04.F9</bpmn:incoming>
      <bpmn:outgoing>P-04.F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-04.G2" name="Удаление подтверждено?" default="P-04.F12">
      <bpmn:incoming>P-04.F10</bpmn:incoming>
      <bpmn:outgoing>P-04.F11</bpmn:outgoing>
      <bpmn:outgoing>P-04.F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P-04.E1" name="Паспортные данные удалены">
      <bpmn:incoming>P-04.F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="P-04.M1" name="Поднять алерт о расхождении">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="observability-alert" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-04.F12</bpmn:incoming>
      <bpmn:outgoing>P-04.F13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_04_2" messageRef="Message_pii_mismatch" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="P-04.E2" name="Расхождение зафиксировано">
      <bpmn:incoming>P-04.F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P-04.F1" sourceRef="P-04.S1" targetRef="P-04.T1" />
    <bpmn:sequenceFlow id="P-04.F2" sourceRef="P-04.T1" targetRef="P-04.G0" />
    <bpmn:sequenceFlow id="P-04.F7" sourceRef="P-04.T3" targetRef="P-04.G0" />
    <bpmn:sequenceFlow id="P-04.F3" sourceRef="P-04.G0" targetRef="P-04.I1" />
    <bpmn:sequenceFlow id="P-04.F4" sourceRef="P-04.I1" targetRef="P-04.T2" />
    <bpmn:sequenceFlow id="P-04.F5" sourceRef="P-04.T2" targetRef="P-04.G1" />
    <bpmn:sequenceFlow id="P-04.F6" name="Есть активные" sourceRef="P-04.G1" targetRef="P-04.T3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=activeBookings &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-04.F8" name="Активных нет" sourceRef="P-04.G1" targetRef="P-04.T4" />
    <bpmn:sequenceFlow id="P-04.F9" sourceRef="P-04.T4" targetRef="P-04.T5" />
    <bpmn:sequenceFlow id="P-04.F10" sourceRef="P-04.T5" targetRef="P-04.G2" />
    <bpmn:sequenceFlow id="P-04.F11" name="Подтверждено" sourceRef="P-04.G2" targetRef="P-04.E1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=purgeVerified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-04.F12" name="Запись с истёкшим TTL осталась" sourceRef="P-04.G2" targetRef="P-04.M1" />
    <bpmn:sequenceFlow id="P-04.F13" sourceRef="P-04.M1" targetRef="P-04.E2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p04">
    <bpmndi:BPMNPlane id="BPMNPlane_p04" bpmnElement="Collaboration_p04">
      <bpmndi:BPMNShape id="Participant_system_p04_di" bpmnElement="Participant_system_p04" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="1530" height="440" />
