<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_p03-rebooking" targetNamespace="http://travel-irops" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0">
  <bpmn:error id="Error_rebooking_failed" name="Перебронирование не выполнено" errorCode="REBOOKING_FAILED" />
  <bpmn:collaboration id="Collaboration_p03">
    <bpmn:participant id="Participant_booking_p03" name="Провайдер бронирования" />
    <bpmn:participant id="Participant_system_p03" name="TravelTech IROPS. Перебронирование" processRef="p03-rebooking" />
    <bpmn:participant id="Participant_payment_p03" name="Платёжный шлюз" />
    <bpmn:messageFlow id="MF-03.1" name="Запрос удержания места" sourceRef="P-03.T1" targetRef="Participant_booking_p03" />
    <bpmn:messageFlow id="MF-03.2" name="Подтверждение холда" sourceRef="Participant_booking_p03" targetRef="P-03.T1" />
    <bpmn:messageFlow id="MF-03.3" name="Авторизация доплаты" sourceRef="P-03.T2" targetRef="Participant_payment_p03" />
    <bpmn:messageFlow id="MF-03.4" name="Результат авторизации" sourceRef="Participant_payment_p03" targetRef="P-03.T2" />
    <bpmn:messageFlow id="MF-03.5" name="Выпуск по PNR, ключ операции" sourceRef="P-03.T4" targetRef="Participant_booking_p03" />
    <bpmn:messageFlow id="MF-03.6" name="Новый билет" sourceRef="Participant_booking_p03" targetRef="P-03.T4" />
    <bpmn:messageFlow id="MF-03.7" name="Отмена старого билета" sourceRef="P-03.T5" targetRef="Participant_booking_p03" />
    <bpmn:messageFlow id="MF-03.8" name="Подтверждение отмены" sourceRef="Participant_booking_p03" targetRef="P-03.T5" />
    <bpmn:messageFlow id="MF-03.9" name="Возврат разницы" sourceRef="P-03.T6" targetRef="Participant_payment_p03" />
    <bpmn:messageFlow id="MF-03.10" name="Результат возврата" sourceRef="Participant_payment_p03" targetRef="P-03.T6" />
  </bpmn:collaboration>
  <bpmn:process id="p03-rebooking" name="P-03 Перебронирование" isExecutable="true">
    <bpmn:startEvent id="P-03.S1" name="Запрошено перебронирование">
      <bpmn:outgoing>P-03.F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P-03.T1" name="Захолдировать место на новом рейсе">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="seat-hold" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F1</bpmn:incoming>
      <bpmn:outgoing>P-03.F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-03.G1" name="Перебронирование вынужденное?" default="P-03.F3">
      <bpmn:incoming>P-03.F2</bpmn:incoming>
      <bpmn:outgoing>P-03.F3</bpmn:outgoing>
      <bpmn:outgoing>P-03.F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-03.T2" name="Авторизовать доплату разницы тарифа">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fare-difference-authorize" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F3</bpmn:incoming>
      <bpmn:outgoing>P-03.F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-03.G2">
      <bpmn:incoming>P-03.F4</bpmn:incoming>
      <bpmn:incoming>P-03.F5</bpmn:incoming>
      <bpmn:outgoing>P-03.F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-03.T3" name="Перенести наземные брони">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ground-rebook" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F6</bpmn:incoming>
      <bpmn:outgoing>P-03.F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P-03.T4" name="Выпустить билет по PNR">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ticket-issue" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F7</bpmn:incoming>
      <bpmn:outgoing>P-03.F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P-03.T5" name="Отменить старый билет">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ticket-void-old" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F8</bpmn:incoming>
      <bpmn:outgoing>P-03.F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P-03.T8" name="Поставить отмену в очередь ретраев">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="void-retry-enqueue" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F17</bpmn:incoming>
      <bpmn:outgoing>P-03.F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-03.G4">
      <bpmn:incoming>P-03.F11</bpmn:incoming>
      <bpmn:incoming>P-03.F12</bpmn:incoming>
      <bpmn:outgoing>P-03.F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-03.T7" name="Зафиксировать изменение в плане поездки">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="plan-apply" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F13</bpmn:incoming>
      <bpmn:outgoing>P-03.F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P-03.E1" name="Перебронирование выполнено">
      <bpmn:incoming>P-03.F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P-03.C3" name="Восстановить наземные брони" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ground-restore" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P-03.C2" name="Снять авторизацию доплаты" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fare-difference-void" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P-03.C1" name="Снять холд" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="seat-hold-release" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P-03.G3" name="Разница отрицательная?" default="P-03.F12">
      <bpmn:incoming>P-03.F9</bpmn:incoming>
      <bpmn:incoming>P-03.F18</bpmn:incoming>
      <bpmn:outgoing>P-03.F10</bpmn:outgoing>
      <bpmn:outgoing>P-03.F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P-03.T6" name="Оформить возврат разницы">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fare-difference-refund" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>P-03.F10</bpmn:incoming>
      <bpmn:outgoing>P-03.F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="P-03.M1" name="Компенсировать выполненные шаги">
      <bpmn:incoming>P-03.F15</bpmn:incoming>
      <bpmn:outgoing>P-03.F16</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CED_03_4" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="P-03.E2" name="Перебронирование не выполнено">
      <bpmn:incoming>P-03.F16</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_03_3" errorRef="Error_rebooking_failed" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="P-03.B6" name="Старый билет не отменён" attachedToRef="P-03.T5">
      <bpmn:outgoing>P-03.F17</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_03_2" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P-03.B5" name="Выпуск не выполнен" attachedToRef="P-03.T4">
      <bpmn:outgoing>P-03.F15</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_03_1" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P-03.B2" attachedToRef="P-03.T3">
      <bpmn:compensateEventDefinition id="CED_03_3" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P-03.B3" attachedToRef="P-03.T2">
      <bpmn:compensateEventDefinition id="CED_03_2" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="P-03.B1" attachedToRef="P-03.T1">
      <bpmn:compensateEventDefinition id="CED_03_1" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="P-03.F1" sourceRef="P-03.S1" targetRef="P-03.T1" />
    <bpmn:sequenceFlow id="P-03.F2" sourceRef="P-03.T1" targetRef="P-03.G1" />
    <bpmn:sequenceFlow id="P-03.F3" name="Добровольное" sourceRef="P-03.G1" targetRef="P-03.T2" />
    <bpmn:sequenceFlow id="P-03.F4" name="Вынужденное, тариф сохраняется" sourceRef="P-03.G1" targetRef="P-03.G2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=involuntary = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-03.F5" sourceRef="P-03.T2" targetRef="P-03.G2" />
    <bpmn:sequenceFlow id="P-03.F6" sourceRef="P-03.G2" targetRef="P-03.T3" />
    <bpmn:sequenceFlow id="P-03.F7" sourceRef="P-03.T3" targetRef="P-03.T4" />
    <bpmn:sequenceFlow id="P-03.F8" sourceRef="P-03.T4" targetRef="P-03.T5" />
    <bpmn:sequenceFlow id="P-03.F9" sourceRef="P-03.T5" targetRef="P-03.G3" />
    <bpmn:sequenceFlow id="P-03.F17" sourceRef="P-03.B6" targetRef="P-03.T8" />
    <bpmn:sequenceFlow id="P-03.F18" sourceRef="P-03.T8" targetRef="P-03.G3" />
    <bpmn:sequenceFlow id="P-03.F11" sourceRef="P-03.T6" targetRef="P-03.G4" />
    <bpmn:sequenceFlow id="P-03.F12" name="Ноль или положительная" sourceRef="P-03.G3" targetRef="P-03.G4" />
    <bpmn:sequenceFlow id="P-03.F13" sourceRef="P-03.G4" targetRef="P-03.T7" />
    <bpmn:sequenceFlow id="P-03.F14" sourceRef="P-03.T7" targetRef="P-03.E1" />
    <bpmn:sequenceFlow id="P-03.F10" name="Отрицательная" sourceRef="P-03.G3" targetRef="P-03.T6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fareDelta &lt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P-03.F15" sourceRef="P-03.B5" targetRef="P-03.M1" />
    <bpmn:sequenceFlow id="P-03.F16" sourceRef="P-03.M1" targetRef="P-03.E2" />
    <bpmn:association id="P-03.A3" associationDirection="One" sourceRef="P-03.B2" targetRef="P-03.C3" />
    <bpmn:association id="P-03.A2" associationDirection="One" sourceRef="P-03.B3" targetRef="P-03.C2" />
    <bpmn:association id="P-03.A1" associationDirection="One" sourceRef="P-03.B1" targetRef="P-03.C1" />
  </bpmn:process>
